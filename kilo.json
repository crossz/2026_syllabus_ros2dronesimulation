{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo-auto/free",
  "default_agent": "code",
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "CONTEXT.md",
    ".kilo/memory/**/*.md",
    ".kilo/memory/**/*.txt"
  ],
  "skills": {
    "paths": [
      ".kilo/skills",
      ".kilo/memory/skills"
    ]
  },
  "permission": {
    "edit": {
      ".kilo/memory/**": "allow",
      "src/**": "allow",
      "*": "ask"
    },
    "read": {
      ".kilo/memory/**": "allow",
      "*": "ask"
    }
  }
}